<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 11+ to query whether the MOICA app is installed -->
    <queries>
        <!-- Matches apps that register only the scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mobilemoica" />
        </intent>
        <!-- Matches apps that also pin the host in their intent-filter -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mobilemoica" android:host="moica.moi.gov.tw" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenACAndroidExample"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.OpenACAndroidExample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep-link target for MOICA app2app callback: openac://callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="openac"
                    android:host="callback" />
            </intent-filter>
            <!-- Deep-link target for PTT OIDC login callback: openac://oidc-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="openac"
                    android:host="oidc-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>